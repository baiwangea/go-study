syntax = "v1"

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	LoginResp {
		Token string `json:"token"`
	}
	UserInfoReq {
		Id int64 `path:"id"`
	}
	UserInfoResp {
		Id       int64  `json:"id"`
		Username string `json:"username"`
		Email    string `json:"email"`
	}
	PingRpcReq {
		Message string `form:"message,optional,default=hello"`
	}
	PingRpcResp {
		Pong string `json:"pong"`
	}
)

service user-api {
	@handler Login
	post /user/login (LoginReq) returns (LoginResp)

	@handler GetUserInfo
	get /user/:id (UserInfoReq) returns (UserInfoResp)

	// 演示 API 层通过 zrpc client 调用下游 user.rpc 服务
	@handler PingRpc
	get /user/rpc/ping (PingRpcReq) returns (PingRpcResp)
}

